{
  "name": "hwn-tracker",
  "private": true,
  "workspaces": [
    "backend",
    "infrastructure"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "android": "npm run android --prefix app",
    "ios": "npm run ios --prefix app",
    "start": "npm run start --prefix app",
    "backend": "npm run dev --prefix backend",
    "dev": "concurrently -n backend,metro -c blue,green \"npm run backend\" \"npm run start\"",
    "clean": "bash scripts/clean.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.67.0"
  }
}
